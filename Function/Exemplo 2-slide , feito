#include <stdio.h>

int minimax ( int mat[5][5]){

    int maior, linhamaior, colmaior;
    int r;

    maior= mat[0][0];
    linhamaior=0; colmaior=0;

    for( int i=0; i<5; i++){
        for( int j=0; j<5; j++){

            if( mat[i][j] > maior){
                maior= mat[i][j];
                linhamaior=i;
                colmaior=j;
            }
        }
    }

    r=mat[linhamaior][0];

    for( int j=1; j<5; j++){

        if( mat[linhamaior][j] < r){
            r=mat[linhamaior][j];
        }
    }

    return r;
}

int main(){

    int mat1[5][5];

    for( int i=0; i<5; i++){
        for( int j=0; j<5; j++){
        
            printf("Informe os elementos da matriz\n");
            scanf("%d", &mat1[i][j]);
        }

    }

    int r1= minimax( mat1);

    printf(" %d\n", r1);

    return 0;
}
