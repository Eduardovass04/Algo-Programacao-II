#include <stdio.h>

int n_pares( int n){

     int  vetor_pares[100];
       int c=0;
      for( int i=0; i<=n; i++){

          if( i % 2==0){
              vetor_pares[c++]=i;
              
            
          }
      }

       for( int i=0; i<c; i++){
          printf("%d", vetor_pares[i]);
       }
       return c;  // aqui ao final ele guarda o total de armazenados
}

int main(){

     int n1, retorno;

     printf("Informe um numero\n");
     scanf("%d", &n1);

          retorno=n_pares(n1);

          printf("%d", retorno);

          return 0;
}
