#include <stdio.h>

int main()
{

  // exemplo de entrada

  // 1 2 3
  // 4 5 6
  // 7 8 9

  // saida*

  // 7 4 1
  //  8 5 2
  //  9 6 3

  int n;

  printf("Informe o tamanho da amtriz\n");
  scanf("%d", &n); //  tam da matriz declarada

  int mat[n][n]; // matriz declarada recebendo o vetor

  for (int i = 0; i < n; i++)
  {
    for (int j = 0; j < n; j++)
    {

      printf("Digite os elementos da matriz\n");
      scanf("%d", &mat[i][j]);
    }
  }

  int a[n][n];

  for (int i = 0; i < n; i++)
  {

    for (int j = 0; j < n; j++)
    {

      a[j][n - 1 - i] = mat[i][j];
    }
  }
  printf("matriz 90 graus\n");

  for (int i = 0; i < n; i++)
  {

    for (int j = 0; j < n; j++)
    {

      printf("%4d", a[i][j]);
    }
    printf("\n");
  }

  return 0;
}
