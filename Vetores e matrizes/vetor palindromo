// palindromo com o uso de vetores

#include <stdio.h>

 int main(){

   int n;

   printf("Informe o tamnho do vetor\n");
   scanf("%d", &n); // declaro o tamanho do vetor

   int e[n]; // declaro o vetor recebendo o seu tamanho

   // faço um laço for para o usuario digitar os elementos

   for( int i=0; i<n; i++){

    printf("Informe os elementos do vetor\n");
    scanf("%d", &e[i]);
   }
         int resultado=1;
   for( int i=0; i<n; i++){
    // laço de apenas uma iteração para eu descobrir o palindromo

    if( e[i] == e[n-1-i]){

      //0 = 0(a)== 4(a)    //[5-1-0]=0
      //1=  1(r)== 3(r)        //[5-1-1]=3
    // 2=   2(a)== 2(r)             //[5-1-2]=2
      resultado=1;
    } else{
       resultado=0;
    }
   }

    // agora é so criar um if pra saber o resultado

    if(resultado==1){
      printf("Palindromo\n");

    } else{
      printf("Nao e palindromo\n");
    }

    return 0;
 }
