#include <stdio.h>

int main(){

    int n;

    printf("Informe o tamanho da matriz\n");
    scanf("%d", &n);

    int a[n][n];

    for( int i=0; i<n; i++){
        for( int j=0; j<n; j++){
            printf("Informe os elementos da matri\n");
            scanf("%d", &a[i][j]);
        }
    }

    for( int i=0; i<n; i++){
        for( int j=0; j<n; j++){
            if( i>=j ){
                if( i==j || j==0){
                       a[i][j]=1;
                } else{
                       a[i][j]= a[i-1][j-1] + a[i-1][j];
                } 

                } else{
                    a[i][j]=0;
                }
        }
    }

     printf("Matriz triangulo de pascal\n");

     for( int i=0; i<n; i++){

        for( int j=0; j<n; j++){
            printf("%4d", a[i][j]);
        }
        printf("\n");
     }

      return 0;
}
