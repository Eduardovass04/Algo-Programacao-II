#include <stdio.h>

int main(){

    int b[4][4];

    for( int i=0; i<4; i++){
        for( int j=0; j<4; j++){
            printf("Digite os elementos da matriz\n");
            scanf("%d", &b[i][j]);
        }
    }
    for( int i=0; i<4; i++){
        for( int j=0; j<4; j++){
            if(  i+j<=3){
                if(b[i][j] % 2==0){
                    b[i][j]=b[i][j] * 2;
                }
            }
        }     
    }
     for( int i=0; i<4; i++){
        for( int j=0; j<4; j++){
            printf("[%4d]", b[i][j]);
        }
        printf("\n");
     }

    return 0;
}
